# ============================================================
# 🌐 Configuración del servidor
# ============================================================
PORT=4000
FRONTEND_URL=http://localhost:5173

# ============================================================
# 🗄️ Configuración de la base de datos MySQL
# ============================================================
DB_NAME=gargobarb
DB_USER=root
DB_PASS=
DB_HOST=127.0.0.1
DB_PORT=3306

# ============================================================
# 🔐 Seguridad JWT
# ============================================================

# Token principal (área crítica — NO compartir)
JWT_SECRET=clave_super_segura_1234

# Token largo para refrescar sesiones
JWT_REFRESH_SECRET=clave_refresh_ultra_segura_9876

# Tiempo por defecto del token (no lo usaremos porque manejaremos 15m y 7d manualmente)
JWT_EXPIRES_IN=7d

# ============================================================
# 🔏 Google OAuth (si lo usas)
# ============================================================
GOOGLE_CLIENT_ID=820070306319-o6pmp2mdhrkpdabhd0uh4mb6fjsqn5fu.apps.googleusercontent.com

# ============================================================
# 💳 Stripe (pagos)
# ============================================================
STRIPE_SECRET=sk_test_yourkey

# ============================================================
